<mxfile host="app.diagrams.net"><diagram name="T-51 Diagrama final G3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="827"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="inet" value="Internet / Red universidad&lt;br&gt;10.50.80.0/24 (GW 10.50.80.1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#7F7F7F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="220" height="50" as="geometry"/></mxCell><mxCell id="mk" value="MikroTik RB3011 (RouterOS 6.46.8)&lt;br&gt;ether2 WAN DHCP 10.50.80.214 · NAT masquerade&lt;br&gt;Firewall T22/T27/T41/T45 · DHCP V10/V60 · SNMPv3&lt;br&gt;GW .1 de VLAN 10-60" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="300" height="90" as="geometry"/></mxCell><mxCell id="sw" value="Cisco SW-G3-PRINCIPAL (C2960+ 24TC-L)&lt;br&gt;Vlan10 192.168.10.2 · Rapid-PVST root&lt;br&gt;SNMPv3 ZABBIX_SNMPV3 (ACL 10)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="300" height="75" as="geometry"/></mxCell><mxCell id="ap" value="UniFi AP (UAP) 192.168.60.245&lt;br&gt;SSID g3-usuarios (WPA2)&lt;br&gt;Fa0/24 · PoE 24 V pasivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="270" width="230" height="75" as="geometry"/></mxCell><mxCell id="pve" value="Proxmox server-integrador3 (10.50.80.112)&lt;br&gt;bridge VLAN-aware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="405" width="300" height="50" as="geometry"/></mxCell><mxCell id="v10" value="VLAN 10 ADMINISTRACION&lt;br&gt;192.168.10.0/24&lt;br&gt;VM-09 AD/DNS .10&lt;br&gt;SW .2 · Router .1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="10" y="515" width="175" height="95" as="geometry"/></mxCell><mxCell id="v20" value="VLAN 20 APLICACIONES&lt;br&gt;192.168.20.0/24&lt;br&gt;VM-01 CRM-01 .11:8080&lt;br&gt;VM-02 CRM-02 .12:80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="515" width="175" height="95" as="geometry"/></mxCell><mxCell id="v30" value="VLAN 30 BASE_DATOS&lt;br&gt;192.168.30.0/24&lt;br&gt;VM-03 MariaDB .11&lt;br&gt;VM-04 MariaDB .12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="515" width="175" height="95" as="geometry"/></mxCell><mxCell id="v40" value="VLAN 40 SERVICIOS&lt;br&gt;192.168.40.0/24&lt;br&gt;VM-05 Zabbix .11&lt;br&gt;VM-06 Grafana .12:3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="515" width="175" height="95" as="geometry"/></mxCell><mxCell id="v50" value="VLAN 50 AUTOMATIZACION&lt;br&gt;192.168.50.0/24&lt;br&gt;VM-07 n8n .11:5678&lt;br&gt;VM-08 RPA .12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="515" width="175" height="95" as="geometry"/></mxCell><mxCell id="v60" value="VLAN 60 USUARIOS&lt;br&gt;192.168.60.0/24 (DHCP)&lt;br&gt;VM-Cliente .20&lt;br&gt;Clientes WiFi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="515" width="175" height="95" as="geometry"/></mxCell><mxCell id="pol" value="Políticas de acceso (firewall MikroTik)&lt;br&gt;• Usuarios (V60) → solo CRM-01:8080, CRM-02:80 y DNS VM-09:53; sin SSH/RDP/BD; sin administración del router ni VLAN 40/50 (T27/T45)&lt;br&gt;• CRM-01 → solo MariaDB VM-03; CRM-02 → solo MariaDB VM-04 (T22/T27)&lt;br&gt;• Zabbix → agentes 10050, ICMP, HTTP CRM, MariaDB; agentes → Zabbix 10051; n8n/RPA → web CRM; n8n → SSH VM-01/02 (T41); resto V40/50 → V20/30 bloqueado&lt;br&gt;• Salida a Internet por NAT masquerade en ether2 (WAN); acceso desde WAN al router bloqueado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="10" y="640" width="1125" height="105" as="geometry"/></mxCell><mxCell id="e0" value="ether2 (WAN)" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="inet" target="mk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="ether3 ↔ Gi0/1 trunk 802.1Q&lt;br&gt;VLAN 10,20,30,40,50,60" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="mk" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Gi0/2 trunk 802.1Q" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="sw" target="pve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Fa0/24 access V60" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="sw" target="ap"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="pve" target="v10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="pve" target="v20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="pve" target="v30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=none;html=1;fontSize=10;strokeWidth=2;" edge="1" parent="1" source="pve" target="v40"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8