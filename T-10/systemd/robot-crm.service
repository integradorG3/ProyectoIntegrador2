[Unit]
Description=Pruebas sinteticas Robot Framework (EspoCRM A y B)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rpa
WorkingDirectory=/opt/rpa
# Credenciales: copiar robot/.env.example a /etc/rpa/crm.env y completar los valores
EnvironmentFile=/etc/rpa/crm.env
# /var/log/rpa persiste entre ejecuciones y guarda el historial CSV (rpa_resultados.csv)
LogsDirectory=rpa
ExecStart=/usr/local/bin/robot --timestampoutputs --outputdir /opt/rpa/resultados --variable HISTORIAL_CSV:/var/log/rpa/rpa_resultados.csv /opt/rpa/crm_synthetic.robot
# Limpia solo los log/report/output de Robot con mas de 14 dias; el historial CSV no se toca
ExecStartPost=/usr/bin/find /opt/rpa/resultados -type f -mtime +14 -delete
