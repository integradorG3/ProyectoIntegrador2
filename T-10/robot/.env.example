# Plantilla de credenciales del script robot/crm_synthetic.robot (sin valores reales).
# Uso en VM-08, desde la carpeta T-10 del repositorio clonado (ver README.md, seccion de credenciales):
#   sudo useradd --system --create-home --home-dir /opt/rpa --shell /usr/sbin/nologin rpa   # solo si no existe
#   sudo mkdir -p /etc/rpa
#   sudo install -m 600 -o rpa -g rpa robot/.env.example /etc/rpa/crm.env
#   sudo nano /etc/rpa/crm.env     # completar los valores reales
# El servicio robot-crm.service lee /etc/rpa/crm.env mediante EnvironmentFile.
# El archivo real NUNCA se sube a GitHub; solo esta plantilla.
CRM_USER=usuario_de_prueba
CRM_PASS=cambiar_por_la_clave_de_prueba
