{
  "name": "CRM - Remediacion controlada (T-10 borrador)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-incidente",
        "authentication": "headerAuth",
        "options": {}
      },
      "id": "n1",
      "name": "Webhook Zabbix",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "crm-incidente",
      "credentials": {
        "httpHeaderAuth": { "id": "REEMPLAZAR", "name": "Token webhook Zabbix" }
      }
    },
    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst permitidos = {\n  crm_linux:   { host: '192.168.20.11', url: 'http://192.168.20.11:8080' },\n  crm_windows: { host: '192.168.20.12', url: 'http://192.168.20.12' }\n};\nconst t = permitidos[b.target];\nreturn [{ json: {\n  target: b.target || null,\n  autorizado: !!t,\n  url: t ? t.url : null,\n  host: t ? t.host : null,\n  t_detect: b.event_time || null,\n  t_inicio_n8n: new Date().toISOString()\n} }];"
      },
      "id": "n2",
      "name": "Validar y marcar tiempo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.autorizado }}", "value2": true }
          ]
        }
      },
      "id": "n3",
      "name": "¿Autorizado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.target }}", "value2": "crm_linux" }
          ]
        }
      },
      "id": "n4",
      "name": "¿Es Linux?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [660, 200]
    },
    {
      "parameters": {
        "command": "sudo /usr/bin/docker restart espocrm",
        "authentication": "privateKey"
      },
      "id": "n5",
      "name": "Reiniciar contenedor (VM-01)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [880, 120],
      "credentials": {
        "sshPrivateKey": { "id": "REEMPLAZAR", "name": "SSH VM-01 n8n-remed" }
      }
    },
    {
      "parameters": {
        "command": "powershell -NoProfile -Command \"Restart-Service W3SVC\"",
        "authentication": "privateKey"
      },
      "id": "n6",
      "name": "Reiniciar IIS (VM-02)",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [880, 300],
      "credentials": {
        "sshPrivateKey": { "id": "REEMPLAZAR", "name": "SSH VM-02 n8n-remed" }
      }
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "n7",
      "name": "Esperar 30 s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1100, 200]
    },
    {
      "parameters": {
        "url": "={{ $('Validar y marcar tiempo').item.json.url }}",
        "options": {
          "timeout": 10000,
          "response": { "response": { "fullResponse": true, "neverError": true } }
        }
      },
      "id": "n8",
      "name": "Verificar HTTP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ !!($json.statusCode && $json.statusCode < 400) }}", "value2": true }
          ]
        }
      },
      "id": "n9",
      "name": "¿Recuperado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1540, 200]
    },
    {
      "parameters": {
        "chatId": "REEMPLAZAR_CHAT_ID",
        "text": "=✅ RECUPERADO: {{ $('Validar y marcar tiempo').item.json.target }}\nInicio n8n: {{ $('Validar y marcar tiempo').item.json.t_inicio_n8n }}\nFin: {{ $now.toISO() }}\nHTTP: {{ $json.statusCode }}",
        "additionalFields": {}
      },
      "id": "n10",
      "name": "Aviso: recuperado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1760, 120],
      "credentials": {
        "telegramApi": { "id": "REEMPLAZAR", "name": "Telegram bot" }
      }
    },
    {
      "parameters": {
        "chatId": "REEMPLAZAR_CHAT_ID",
        "text": "=❌ FALLO: {{ $('Validar y marcar tiempo').item.json.target }} sigue sin responder tras el reinicio.\nSe requiere intervencion humana.\nInicio n8n: {{ $('Validar y marcar tiempo').item.json.t_inicio_n8n }}\nFin: {{ $now.toISO() }}",
        "additionalFields": {}
      },
      "id": "n11",
      "name": "Aviso: FALLO",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1760, 300],
      "credentials": {
        "telegramApi": { "id": "REEMPLAZAR", "name": "Telegram bot" }
      }
    },
    {
      "parameters": {
        "chatId": "REEMPLAZAR_CHAT_ID",
        "text": "=⚠️ Intento NO autorizado en el webhook de remediacion. Objetivo recibido: {{ $json.target }}",
        "additionalFields": {}
      },
      "id": "n12",
      "name": "Aviso: no autorizado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [660, 440],
      "credentials": {
        "telegramApi": { "id": "REEMPLAZAR", "name": "Telegram bot" }
      }
    }
  ],
  "connections": {
    "Webhook Zabbix": {
      "main": [[{ "node": "Validar y marcar tiempo", "type": "main", "index": 0 }]]
    },
    "Validar y marcar tiempo": {
      "main": [[{ "node": "¿Autorizado?", "type": "main", "index": 0 }]]
    },
    "¿Autorizado?": {
      "main": [
        [{ "node": "¿Es Linux?", "type": "main", "index": 0 }],
        [{ "node": "Aviso: no autorizado", "type": "main", "index": 0 }]
      ]
    },
    "¿Es Linux?": {
      "main": [
        [{ "node": "Reiniciar contenedor (VM-01)", "type": "main", "index": 0 }],
        [{ "node": "Reiniciar IIS (VM-02)", "type": "main", "index": 0 }]
      ]
    },
    "Reiniciar contenedor (VM-01)": {
      "main": [[{ "node": "Esperar 30 s", "type": "main", "index": 0 }]]
    },
    "Reiniciar IIS (VM-02)": {
      "main": [[{ "node": "Esperar 30 s", "type": "main", "index": 0 }]]
    },
    "Esperar 30 s": {
      "main": [[{ "node": "Verificar HTTP", "type": "main", "index": 0 }]]
    },
    "Verificar HTTP": {
      "main": [[{ "node": "¿Recuperado?", "type": "main", "index": 0 }]]
    },
    "¿Recuperado?": {
      "main": [
        [{ "node": "Aviso: recuperado", "type": "main", "index": 0 }],
        [{ "node": "Aviso: FALLO", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
