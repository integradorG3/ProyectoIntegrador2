    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// MODO PRUEBA:\n// no se llama al endpoint de reboot de Proxmox.\nreturn {\n  json: {\n    ...$json,\n    simulacion: true,\n    reboot_solicitado: false,\n    mensaje_simulacion: 'Reinicio de VM simulado; no se ejecutó ninguna acción real en Proxmox.'\n  }\n};"
      },
      "id": "fa66a3a9-c1eb-4eaf-92b7-fe4cabfc5c22",
      "name": "Simular reinicio VM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        800
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ==================================================\n// CONSERVAR CONTEXTO DEL INTENTO\n// ==================================================\n\nlet contexto;\n\n// Si venimos de un reintento, usar el intento más reciente.\ntry {\n  const retry = $('Control de reintentos').last().json;\n\n  if (\n    retry &&\n    retry.intento !== undefined &&\n    Number(retry.intento) > 1\n  ) {\n    contexto = retry;\n  }\n} catch (e) {\n  // Primer intento.\n}\n\n// Si es el primer intento, usar la inicialización.\nif (!contexto) {\n  contexto = $('Preparar control de intentos').first().json;\n}\n\n// En modo prueba, el input ya conserva el contexto.\n// En producción, el HTTP Request de reboot devuelve su propia respuesta,\n// así que reconstruimos el contexto con los nodos anteriores.\nreturn {\n  json: {\n    ...contexto,\n    t_reinicio_ms: Date.now(),\n    reboot_solicitado: !contexto.modo_prueba,\n    simulacion: contexto.modo_prueba === true\n  }\n};"
      },
      "id": "38a55aad-6be6-4b0a-b540-c74f5535c5f8",
      "name": "Marcar intento de reinicio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        576
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ==================================================\n// RESULTADO DE VERIFICACIÓN FALLIDA\n// ==================================================\n\nconst c = $('Marcar intento de reinicio').last().json;\nconst verificacion = $json;\n\nconst intentoActual = Number(c.intento ?? 1);\nconst maxIntentos = Number(c.max ?? 4);\nconst quedanIntentos = intentoActual < maxIntentos;\n\nconst statusVM =\n  verificacion?.data?.status ??\n  'sin respuesta';\n\nconst mensaje = [\n  '❌ T200 - VM NO RECUPERADA',\n  '',\n  'VM: ' + c.host,\n  'VMID: ' + c.vmid,\n  'Alerta: ' + c.trigger,\n  'Severidad: ' + c.severity,\n  '',\n  'Intento: ' + intentoActual + ' de ' + maxIntentos,\n  'Estado observado: ' + statusVM,\n  c.modo_prueba ? 'Modo: PRUEBA CONTROLADA (sin reinicio real)' : 'Modo: PRODUCCIÓN',\n  '',\n  quedanIntentos\n    ? 'La recuperación automática volverá a intentarse.'\n    : 'Se agotaron los 4 intentos automáticos. Se requiere intervención manual.'\n].join('\\n');\n\nreturn {\n  json: {\n    ...c,\n    intento: intentoActual,\n    max: maxIntentos,\n    quedan_intentos: quedanIntentos,\n    estado_vm: statusVM,\n    mensaje\n  }\n};"
      },
