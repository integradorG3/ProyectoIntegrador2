    {
      "parameters": {
        "jsCode": "// ==================================================\n// VALIDAR ALERTA - REINICIO VM POR ALTO CONSUMO\n// ==================================================\n//\n// MODO_PRUEBA = true:\n//   - NO reinicia ninguna VM real.\n//   - Fuerza la verificación final por la rama FALSE.\n//   - Permite probar los 4 intentos de forma segura.\n//\n// PARA PRODUCCIÓN:\n//   cambiar SOLO esta línea a false.\n// ==================================================\n\nconst MODO_PRUEBA = false;\n\nconst b = $json.body ?? $json;\n\nconst host = String(b.host ?? \"\").trim();\nconst trigger = String(b.trigger ?? \"\");\nconst severity = String(b.severity ?? \"\").toLowerCase();\n\n// VMIDs reales en Proxmox\nconst vms = {\n  \"VM-AD-DNS\": 102,\n  \"EspoCRM-Windows\": 103,\n  \"EspoCRM-Ubuntu\": 104,\n  \"MariaDB-Windows\": 105,\n  \"MariaDB-Ubuntu\": 106,\n  \"Zabbix server\": 107,\n  \"VM-n8n\": 108,\n  \"VM-RPA\": 109,\n  \"VM-Grafana\": 110\n};\n\nconst vmid = vms[host];\n\nconst severidadOK = [\n  \"warning\",\n  \"advertencia\",\n  \"average\",\n  \"promedio\",\n  \"high\",\n  \"alta\",\n  \"disaster\",\n  \"desastre\",\n  \"2\",\n  \"3\",\n  \"4\",\n  \"5\"\n].includes(severity);\n\n// Solo alertas relacionadas con consumo de recursos\nconst recursoOK =\n  /cpu|processor|procesador|memory|memoria|ram|swap|load average/i.test(trigger);\n\nlet autorizado = true;\nlet motivo = \"Autorizada\";\n\nif (!vmid) {\n  autorizado = false;\n  motivo = `Host no registrado: ${host}`;\n} else if (!severidadOK) {\n  autorizado = false;\n  motivo = `Severidad no autorizada: ${b.severity}`;\n} else if (!recursoOK) {\n  autorizado = false;\n  motivo = \"La alerta no corresponde a consumo de recursos\";\n}\n\nreturn [{\n  json: {\n    autorizado,\n    motivo,\n    host,\n    trigger,\n    severity: b.severity,\n    eventid: b.eventid,\n    vmid,\n    node: \"server-integrador3\",\n    modo_prueba: MODO_PRUEBA,\n    intento: 1,\n    max: 4\n  }\n}];"
      },
