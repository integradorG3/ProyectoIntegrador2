    {
      "parameters": {
        "jsCode": "const j = $json;\n\n// ==================================================\n// CONTADOR DE INTENTOS - MARIADB WINDOWS\n// ==================================================\n\nconst intentoAnterior =\n  Number(j.intento ?? 0);\n\nconst intentoActual =\n  intentoAnterior + 1;\n\n\n// ==================================================\n// MAXIMO FIJO DE INTENTOS\n// ==================================================\n\nconst maxIntentos = 4;\n\n\n// ==================================================\n// SALIDA\n// ==================================================\n\nreturn {\n  json: {\n\n    ...j,\n\n    intento:\n      intentoActual,\n\n    intentos_en_ventana:\n      intentoActual,\n\n    max:\n      maxIntentos,\n\n    max_reinicios:\n      maxIntentos\n\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        256
      ],
      "id": "4ceb0438-4da1-4a91-8bf4-b2ccae5f7295",
      "name": "Control de reintentos"
    },
    {
      "parameters": {
        "jsCode": "// ==================================================\n// RESTAURAR CONTEXTO DEL INTENTO\n// MariaDB Windows - T200\n// ==================================================\n\n// Respuesta recibida desde Zabbix\nconst verificacionZabbix = $json;\n\n// Datos del intento actual antes de entrar\n// a los nodos HTTP\nconst contexto =\n  $('Control de reintentos').last().json;\n\n// Número actual de intento\nconst intentoActual =\n  Number(contexto.intento ?? 1);\n\n// Máximo fijo\nconst maxIntentos = 4;\n\n\n// ==================================================\n// COMBINAR CONTEXTO + RESPUESTA ZABBIX\n// ==================================================\n\nreturn {\n  json: {\n\n    // Datos originales:\n    // host, trigger, eventid, etc.\n    ...contexto,\n\n    // Respuesta de event.get de Zabbix\n    ...verificacionZabbix,\n\n    // Restauramos explícitamente el contador\n    intento:\n      intentoActual,\n\n    intentos_en_ventana:\n      intentoActual,\n\n    max:\n      maxIntentos,\n\n    max_reinicios:\n      maxIntentos\n\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
